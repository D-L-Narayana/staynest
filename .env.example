# Copy to .env.local. Both values are safe to expose in the browser (RLS protects the data).
# Without them the app still runs: reviews/bookings fall back to in-memory behaviour.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: canonical URL used for metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
